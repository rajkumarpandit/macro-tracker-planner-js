rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for common validations
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Note: isCurrentUser replaces the need for isOwner
    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Daily food log - users can only read, write, and delete their own data
    match /daily_food_log/{document=**} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId 
                    && request.auth.uid == request.resource.data.userId; // Prevent userId change
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // Food master rules - fully personal database, users can only access their own food items
    match /food_calorie_master/{foodId} {
      // Users can only read their own food items
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Users can create food items and must include their userId
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid;
      
      // Users can only update or delete their own food items, and can't change the userId
      allow update: if isSignedIn() && 
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == request.auth.uid; // Prevent userId change
      
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // User profile data
    match /users/{userId} {
      // Allow anyone to list users (for signup limit check - only reads createdAt field)
      // Allow users to read their own data and admins to read all user data
      allow read: if true;
      
      // Allow users to create/update their own data and admins to update any user
      allow create, update: if isCurrentUser(userId) ||
                            (isSignedIn() && request.auth.token.email in ['rajkumarpandit@gmail.com', 'admin@example.com']);
      
      // Allow users to delete their own account and admins to delete any user
      allow delete: if isCurrentUser(userId) ||
                    (isSignedIn() && request.auth.token.email in ['rajkumarpandit@gmail.com', 'admin@example.com']);
    }
    
    // User goals collection - for storing personal fitness/nutrition goals
    match /user_goals/{goalId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && 
                    resource.data.userId == request.auth.uid && 
                    request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Macro targets - personal macro nutrition targets
    match /macro_targets/{targetId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && 
                    resource.data.userId == request.auth.uid && 
                    request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Admin collection - restricted to admin users only
    match /admin/{document=**} {
      // Admin access based on hardcoded admin emails
      allow read, write: if isSignedIn() && 
                           (request.auth.token.email in ['rajkumarpandit@gmail.com', 'admin@example.com']);
    }
    
    // Admin users collection - allows admins to manage the admin users list
    match /admin_users/{email} {
      // For reading the admin_users collection
      allow read: if isSignedIn();
      
      // For initializing admin collection (matches config) and admin operations
      allow write: if isSignedIn() && 
                    (request.auth.token.email in ['rajkumarpandit@gmail.com', 'admin@example.com']);
    }
    
    // Food master - now protected by admin emails for write access
    match /food_master/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && 
                    (request.auth.token.email in ['rajkumarpandit@gmail.com', 'admin@example.com']);
    }
    
    // Weight tracking - users can only access their own weight data
    match /weights/{weightId} {
      // Simpler rule: allow read operations if user is signed in
      // We'll rely on the query to filter by userId
      allow read: if isSignedIn();
      
      // For write operations, ensure user can only write their own data
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId 
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // Biceps tracking - users can only access their own biceps data
    match /biceps/{bicepsId} {
      allow read: if isSignedIn();
      
      // For write operations, ensure user can only write their own data
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId 
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // Waist tracking - users can only access their own waist data
    match /waist/{waistId} {
      allow read: if isSignedIn();
      
      // For write operations, ensure user can only write their own data
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId 
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // Chest tracking - users can only access their own chest data
    match /chest/{chestId} {
      allow read: if isSignedIn();
      
      // For write operations, ensure user can only write their own data
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId 
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // Hips tracking - users can only access their own hips data
    match /hips/{hipsId} {
      allow read: if isSignedIn();
      
      // For write operations, ensure user can only write their own data
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId 
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // Macro targets - users can only access their own macro targets
    match /macro_targets/{targetId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid 
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Calories burnt log - users can only access their own activity data
    match /calories_burnt_log/{logId} {
      allow read: if isSignedIn();
      
      // For write operations, ensure user can only write their own data
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId 
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // Exercise plans - users can only access their own workout plans
    match /exercise_plans/{planId} {
      allow read: if isSignedIn();
      
      // For write operations, ensure user can only write their own data
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId 
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // Workout sessions - users can only access their own workout session logs
    match /workout_sessions/{sessionId} {
      allow read: if isSignedIn();
      
      // For write operations, ensure user can only write their own data
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId 
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // App settings - maintenance mode and other app-wide settings
    match /app_settings/{settingId} {
      // Allow anyone to read settings (needed for signup limit check before authentication)
      // This is safe as it only contains public configuration like limits and maintenance mode
      allow read: if true;
      
      // Only admins can write/update settings
      allow write: if isSignedIn() && 
                    (request.auth.token.email in ['rajkumarpandit@gmail.com', 'admin@example.com']);
    }
    
    // User API usage tracking - users can only read/write their own usage data
    match /user_api_usage/{usageId} {
      // Allow read if the document starts with the user's ID
      allow read: if isSignedIn() && usageId.matches('^' + request.auth.uid + '_.*');
      
      // Allow create/update if the document starts with the user's ID and userId field matches
      allow create, update: if isSignedIn() && 
                            usageId.matches('^' + request.auth.uid + '_.*') &&
                            request.resource.data.userId == request.auth.uid;
      
      // Admins can read all usage data
      allow read: if isSignedIn() && 
                   (request.auth.token.email in ['rajkumarpandit@gmail.com', 'admin@example.com']);
    }
  }
}